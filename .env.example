# --- Anthropic ---
ANTHROPIC_API_KEY=
# KALSHI_AGENT_MODEL=claude-opus-5
# KALSHI_AGENT_EFFORT=high

# --- Kalshi ---
# demo (default) or prod. Prod also requires typing CONFIRM PROD at startup.
KALSHI_ENV=demo
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# --- Safety ---
# DRY_RUN=true runs every order through the risk guard and logs it, but never sends it.
DRY_RUN=true
KILL_SWITCH=false

# --- Risk limits (all money values in cents) ---
MAX_ORDER_COST_CENTS=2500
MAX_POSITION_CONTRACTS_PER_MARKET=100
MAX_TOTAL_EXPOSURE_CENTS=20000
MAX_ORDERS_PER_SESSION=20
MAX_SESSION_LOSS_CENTS=5000
MAX_SLIPPAGE_CENTS=3
# Comma-separated ticker prefixes. Empty allowlist = all tickers allowed.
ALLOWED_TICKER_PREFIXES=
BLOCKED_TICKER_PREFIXES=

AUDIT_LOG_PATH=logs/audit.jsonl
